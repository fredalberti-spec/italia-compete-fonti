FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-irina.txt .
RUN pip install --no-cache-dir -r requirements-irina.txt
COPY irina_inbox.py irina_processor.py irina_server.py worker.py ./
COPY irina_public ./irina_public
ENV PYTHONUNBUFFERED=1
CMD ["python", "irina_server.py"]
